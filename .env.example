# Built-in documentation, templates, metadata checks, and dashboard tools need no key.
HOST=127.0.0.1
PORT=3000
MAX_UPLOAD_MB=10

# Enable ONE AI provider. Keep actual secrets in Render's Environment settings.
AI_PROVIDER=gemini
GEMINI_MODEL=gemini-2.5-flash
# GEMINI_API_KEY=

# Alternative: AI_PROVIDER=openai
# OPENAI_MODEL=gpt-4.1-mini
# OPENAI_API_KEY=

# Alternative: AI_PROVIDER=ollama. Ollama must be reachable from this server.
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=powerbi

# Recommended for publicly hosted AI: restrict use with your own private token.
# AI_ACCESS_TOKEN=
